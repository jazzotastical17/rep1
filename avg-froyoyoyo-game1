        /* Initialize App on Load */
        window.addEventListener('DOMContentLoaded', () => {
            loadSavedProgress();
            renderLevelSelectionBadges();
            initCanvas();
            setupAudio();
        });

        function loadSavedProgress() {
            try {
                const saved = localStorage.getItem('froyo_unlocked_levels');
                if (saved) {
                    unlockedLevels = JSON.parse(saved);
                }
            } catch(e) {
                console.log("LocalStorage not available:", e);
            }
        }

        function saveProgress() {
            try {
                localStorage.setItem('froyo_unlocked_levels', JSON.stringify(unlockedLevels));
            } catch(e) {}
        }

        function renderLevelSelectionBadges() {
            for (let i = 1; i <= 3; i++) {
                const badge = document.getElementById(`badge-lvl${i+1}`);
                if (badge) {
                    if (unlockedLevels[i]) {
                        badge.innerText = "Unlocked";
                        badge.className = "text-xs bg-emerald-300 text-emerald-950 px-2 py-0.5 rounded-full border border-emerald-800";
                    }
                }
            }
        }

        /* Audio Controls with Tone.js */
        let synth = null;
        let noiseSynth = null;

        function setupAudio() {
            try {
                synth = new Tone.Synth({
                    oscillator: { type: 'sine' },
                    envelope: { attack: 0.01, decay: 0.1, sustain: 0.2, release: 0.2 }
                }).toDestination();

                noiseSynth = new Tone.NoiseSynth({
                    noise: { type: 'pink' },
                    envelope: { attack: 0.05, decay: 0.1, sustain: 0.1, release: 0.1 }
                }).toDestination();
                noiseSynth.volume.value = -12;
            } catch (e) {
                console.log("Audio initialization delayed until user gesture");
            }
        }

        function playSound(type) {
            if (audioMuted) return;
            try {
                if (Tone.context.state !== 'running') {
                    Tone.start();
                }
                if (type === 'click' && synth) {
                    synth.triggerAttackRelease("C5", "8n");
                } else if (type === 'pour' && noiseSynth) {
                    noiseSynth.triggerAttackRelease("16n");
                } else if (type === 'win' && synth) {
                    synth.triggerAttackRelease("G5", "8n", Tone.now());
                    synth.triggerAttackRelease("C6", "4n", Tone.now() + 0.15);
                } else if (type === 'topping' && synth) {
                    synth.triggerAttackRelease("E5", "16n");
                } else if (type === 'retry' && synth) {
                    synth.triggerAttackRelease("A3", "4n");
                }
            } catch(e) {}
        }

        function toggleSound() {
            audioMuted = !audioMuted;
            document.getElementById('sound-icon').innerText = audioMuted ? "🔇" : "🔊";
        }

        /* Screen & Flow Navigation */
        function selectLevelAndStart(levelIdx) {
            playSound('click');
            currentLevelIndex = levelIdx;
            currentCustomerIndex = 0;
            customerScores = [];

            const levelData = GAME_LEVELS[currentLevelIndex];

            // Set Body Theme
            const body = document.getElementById('app-body');
            body.className = `min-h-screen flex flex-col justify-between overflow-x-hidden selection:bg-pink-200 theme-${levelData.style}`;

            // Update Header Subtitle
            document.getElementById('level-subtitle').innerText = levelData.title;

            // Switch Views
            document.getElementById('view-menu').classList.add('hidden');
            document.getElementById('view-game').classList.remove('hidden');

            // Render Control Panels for this Level
            buildControlPanels(levelData);

            // Load First Customer
            loadCustomer(0);
        }

        function returnToMenu() {
            playSound('click');
            document.getElementById('view-summary').classList.add('hidden');
            document.getElementById('view-game').classList.add('hidden');
            document.getElementById('view-menu').classList.remove('hidden');
            
            // Default back to tutorial theme for main menu
            document.getElementById('app-body').className = "theme-tutorial min-h-screen flex flex-col justify-between overflow-x-hidden selection:bg-pink-200";
            document.getElementById('level-subtitle').innerText = "Select a Level to Start";
        }

        function restartLevel() {
            playSound('click');
            document.getElementById('view-summary').classList.add('hidden');
            selectLevelAndStart(currentLevelIndex);
        }

        function goToNextLevel() {
            playSound('click');
            document.getElementById('view-summary').classList.add('hidden');
            if (currentLevelIndex + 1 < GAME_LEVELS.length) {
                selectLevelAndStart(currentLevelIndex + 1);
            } else {
                returnToMenu();
            }
        }

        /* Build Dynamic Panels for Level */
        function buildControlPanels(levelData) {
            // 1. Cups Panel
            const cupContainer = document.getElementById('cup-selector-container');
            cupContainer.innerHTML = '';
            levelData.cupsAvailable.forEach(cupKey => {
                const cup = CUP_DATA[cupKey];
                const btn = document.createElement('button');
                btn.className = 'doodle-button bg-orange-100 hover:bg-orange-200 text-amber-950 font-bold p-2 text-sm flex items-center justify-between gap-2';
                btn.onclick = () => selectCup(cupKey);
                btn.innerHTML = `<span>${cup.icon} ${cup.label}</span> <span class="text-xs bg-white px-2 py-0.5 rounded border border-amber-900">Select</span>`;
                cupContainer.appendChild(btn);
            });

            // 2. Flavors Panel
            const flavorContainer = document.getElementById('flavor-selector-container');
            flavorContainer.innerHTML = '';
            levelData.flavorsAvailable.forEach(flavorKey => {
                const flavor = FLAVOR_DATA[flavorKey];
                const wrapper = document.createElement('div');
                wrapper.className = 'flex items-center gap-2 bg-slate-50 p-2 rounded-xl border-2 border-amber-900';
                
                wrapper.innerHTML = `
                    <div class="flex-grow font-bold text-xs text-amber-950">${flavor.name}</div>
                    <button 
                        onmousedown="startPour('${flavorKey}')" 
                        onmouseup="stopPour()" 
                        onmouseleave="stopPour()"
                        ontouchstart="startPour('${flavorKey}')"
                        ontouchend="stopPour()"
                        id="lever-${flavorKey}"
                        class="doodle-button bg-amber-400 hover:bg-amber-300 text-amber-950 text-xs font-black px-3 py-2 flex items-center gap-1 cursor-pointer">
                        <span>🎚️ HOLD LEVER</span>
                    </button>
                `;
                flavorContainer.appendChild(wrapper);
            });

            // 3. Toppings Panel
            const toppingContainer = document.getElementById('toppings-selector-container');
            toppingContainer.innerHTML = '';
            levelData.toppingsAvailable.forEach(toppingKey => {
                const topping = TOPPING_DATA[toppingKey];
                const btn = document.createElement('button');
                btn.id = `topping-btn-${toppingKey}`;
                btn.className = 'doodle-button bg-amber-100 hover:bg-amber-200 text-amber-950 font-bold p-2 text-xs flex items-center justify-between gap-1';
                btn.onclick = () => toggleTopping(toppingKey);
                btn.innerHTML = `<span>${topping.icon} ${topping.name}</span><span id="check-${toppingKey}" class="text-xs font-extrabold text-slate-400">+</span>`;
                toppingContainer.appendChild(btn);
            });
        }

        /* Load Customer into Game Banner */
        function loadCustomer(custIdx) {
            currentCustomerIndex = custIdx;
            const levelData = GAME_LEVELS[currentLevelIndex];
            const customer = levelData.customers[currentCustomerIndex];

            document.getElementById('customer-avatar').innerText = customer.avatar;
            document.getElementById('customer-name').innerText = `${customer.name} (${custIdx + 1}/${levelData.customers.length})`;
            document.getElementById('customer-dialogue').innerText = `"${customer.dialogue}"`;
            document.getElementById('order-recipe-tag').innerText = `Recipe Target: ${customer.recipeHint}`;

            // Reset player cup state
            clearCup();
            customerStartTime = Date.now();
        }

        /* Cup & Drawing Mechanics */
        function selectCup(cupType) {
            playSound('click');
            playerCup.selectedCup = cupType;
            document.getElementById('step1-check').innerText = '✅';
            document.getElementById('canvas-hint').innerText = `Selected ${CUP_DATA[cupType].label}! Now hold down a flavor lever to pour!`;
            drawCanvas();
        }

        function startPour(flavorKey) {
            if (!playerCup.selectedCup) {
                alert("Please select a cup size first!");
                return;
            }
            if (playerCup.flavor && playerCup.flavor !== flavorKey) {
                // If already poured a different flavor, clear cup or allow mix
                playerCup.flavor = flavorKey;
            } else {
                playerCup.flavor = flavorKey;
            }

            document.getElementById(`lever-${flavorKey}`)?.classList.add('lever-active');
            isPouring = true;
            
            if (pourInterval) clearInterval(pourInterval);
            pourInterval = setInterval(() => {
                if (isPouring) {
                    if (playerCup.flavorAmount < 100) {
                        playerCup.flavorAmount += 4;
                        playSound('pour');
                        document.getElementById('step2-check').innerText = '✅';
                        document.getElementById('canvas-hint').innerText = `Pouring ${FLAVOR_DATA[flavorKey].name}... (${playerCup.flavorAmount}%)`;
                        drawCanvas();
                    } else {
                        stopPour();
                        document.getElementById('canvas-hint').innerText = "Cup is completely full! Now add your toppings.";
                    }
                }
            }, 100);
        }

        function stopPour() {
            isPouring = false;
            if (pourInterval) clearInterval(pourInterval);
            if (playerCup.flavor) {
                document.getElementById(`lever-${playerCup.flavor}`)?.classList.remove('lever-active');
            }
        }

        function toggleTopping(toppingKey) {
            if (!playerCup.selectedCup || playerCup.flavorAmount <= 0) {
                alert("Please pick a cup and dispense froyo before adding toppings!");
                return;
            }

            playSound('topping');
            const idx = playerCup.toppings.indexOf(toppingKey);
            const checkElem = document.getElementById(`check-${toppingKey}`);
            const btnElem = document.getElementById(`topping-btn-${toppingKey}`);

            if (idx > -1) {
                // Remove
                playerCup.toppings.splice(idx, 1);
                if (checkElem) checkElem.innerText = '+';
                if (btnElem) btnElem.classList.remove('bg-emerald-300');
            } else {
                // Add
                playerCup.toppings.push(toppingKey);
                if (checkElem) checkElem.innerText = '✅';
                if (btnElem) btnElem.classList.add('bg-emerald-300');
            }

            document.getElementById('step3-check').innerText = playerCup.toppings.length > 0 ? '✅' : '⭕';
            drawCanvas();
        }

        function clearCup() {
            playerCup = {
                selectedCup: null,
                flavor: null,
                flavorAmount: 0,
                toppings: []
            };

            document.getElementById('step1-check').innerText = '⭕';
            document.getElementById('step2-check').innerText = '⭕';
            document.getElementById('step3-check').innerText = '⭕';
            document.getElementById('canvas-hint').innerText = 'Select a cup to begin!';

            // Reset topping button highlights
            const levelData = GAME_LEVELS[currentLevelIndex];
            levelData.toppingsAvailable.forEach(tKey => {
                const checkElem = document.getElementById(`check-${tKey}`);
                const btnElem = document.getElementById(`topping-btn-${tKey}`);
                if (checkElem) checkElem.innerText = '+';
                if (btnElem) btnElem.classList.remove('bg-emerald-300');
            });

            drawCanvas();
        }

        /* Interactive Canvas Rendering Engine */
        let canvas, ctx;

        function initCanvas() {
            canvas = document.getElementById('froyoCanvas');
            ctx = canvas.getContext('2d');
            drawCanvas();
        }

        function drawCanvas() {
            if (!ctx) return;

            // Clear Canvas
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Draw Counter Top Base Line
            ctx.fillStyle = '#D97706';
            ctx.fillRect(10, canvas.height - 25, canvas.width - 20, 10);
            ctx.fillStyle = '#B45309';
            ctx.fillRect(10, canvas.height - 15, canvas.width - 20, 15);

            if (!playerCup.selectedCup) {
                // Draw outline silhouette of a cup
                ctx.strokeStyle = '#CBD5E1';
                ctx.setLineDash([5, 5]);
                ctx.lineWidth = 3;
                ctx.strokeRect(canvas.width / 2 - 40, canvas.height - 130, 80, 100);
                ctx.setLineDash([]);
                return;
            }

            const cupMeta = CUP_DATA[playerCup.selectedCup];
            const cupW = cupMeta.width;
            const cupH = cupMeta.height;
            const centerX = canvas.width / 2;
            const cupBottomY = canvas.height - 25;
            const cupTopY = cupBottomY - cupH;

            // 1. Draw Froyo Swirl (if poured)
            if (playerCup.flavorAmount > 0 && playerCup.flavor) {
                drawFroyoSwirl(centerX, cupTopY + 10, playerCup.flavor, playerCup.flavorAmount);
            }

            // 2. Draw Cup Container (Over top of bottom froyo for realistic depth)
            ctx.save();
            ctx.lineWidth = 4;
            ctx.strokeStyle = '#332722';

            // Cup Body Path (Trapezoid cup)
            const topRadius = cupW / 2;
            const bottomRadius = (cupW * 0.75) / 2;

            ctx.beginPath();
            ctx.moveTo(centerX - topRadius, cupTopY);
            ctx.lineTo(centerX + topRadius, cupTopY);
            ctx.lineTo(centerX + bottomRadius, cupBottomY);
            ctx.lineTo(centerX - bottomRadius, cupBottomY);
            ctx.closePath();

            // Cup Fill
            ctx.fillStyle = '#FFFFFF';
            ctx.fill();
            ctx.stroke();

            // Decorative Cup Stripes based on theme
            ctx.fillStyle = (GAME_LEVELS[currentLevelIndex].style === 'retro') ? '#FF007F' : 
                            (GAME_LEVELS[currentLevelIndex].style === 'moon') ? '#A855F7' : '#F43F5E';
            ctx.fillRect(centerX - topRadius + 6, cupTopY + (cupH * 0.4), (topRadius * 2) - 12, 12);

            ctx.restore();

            // 3. Draw Toppings (On top of swirl)
            if (playerCup.toppings.length > 0 && playerCup.flavorAmount > 0) {
                drawToppings(centerX, cupTopY - 20, playerCup.toppings);
            }
        }

        function drawFroyoSwirl(centerX, baseY, flavorKey, amountPct) {
            const flavor = FLAVOR_DATA[flavorKey];
            const maxSwirlHeight = 120;
            const actualHeight = (amountPct / 100) * maxSwirlHeight;

            ctx.save();
            
            // Draw multi-layered swirl blobs
            const layers = Math.min(5, Math.ceil((amountPct / 100) * 5));
            for (let i = 0; i < layers; i++) {
                const layerY = baseY - (i * (actualHeight / layers));
                const layerWidth = 80 - (i * 12);
                const layerHeight = 35;

                ctx.beginPath();
                ctx.ellipse(centerX, layerY, layerWidth / 2, layerHeight / 2, 0, 0, Math.PI * 2);
                
                // Flavor color with dual tone for Strawberry & Mooncheese
                if ((flavorKey === 'strawberry' || flavorKey === 'mooncheese') && i % 2 === 1) {
                    ctx.fillStyle = flavor.secondColor;
                } else {
                    ctx.fillStyle = flavor.color;
                }
                ctx.fill();
                ctx.lineWidth = 3;
                ctx.strokeStyle = flavor.stroke;
                ctx.stroke();
            }

            // Swirl Top Curl Tip
            if (amountPct > 40) {
                const topY = baseY - actualHeight - 5;
                ctx.beginPath();
                ctx.arc(centerX - 4, topY, 12, 0, Math.PI * 2);
                ctx.fillStyle = flavor.color;
                ctx.fill();
                ctx.stroke();
            }

            ctx.restore();
        }

        function drawToppings(centerX, topY, toppings) {
            ctx.save();
            
            toppings.forEach((toppingKey) => {
                if (toppingKey === 'sprinkles' || toppingKey === 'mooncheese_sprinkles') {
                    const colors = toppingKey === 'sprinkles' ? ['#EF4444', '#3B82F6', '#10B981', '#F59E0B', '#EC4899'] : ['#FACC15', '#EAB308', '#FEF08A'];
                    for (let i = 0; i < 20; i++) {
                        const rx = centerX + (Math.random() * 70 - 35);
                        const ry = topY + (Math.random() * 60 - 30);
                        ctx.fillStyle = colors[i % colors.length];
                        ctx.fillRect(rx, ry, 8, 4);
                    }
                } else if (toppingKey === 'strawberries') {
                    const coords = [[-20, 10], [15, 0], [0, -15]];
                    coords.forEach(([dx, dy]) => {
                        ctx.font = '22px sans-serif';
                        ctx.fillText('🍓', centerX + dx - 10, topY + dy);
                    });
                } else if (toppingKey === 'blackberries') {
                    const coords = [[-25, 5], [10, -5], [5, 15]];
                    coords.forEach(([dx, dy]) => {
                        ctx.font = '22px sans-serif';
                        ctx.fillText('🫐', centerX + dx - 10, topY + dy);
                    });
                } else if (toppingKey === 'choco_chips') {
                    for (let i = 0; i < 14; i++) {
                        const rx = centerX + (Math.sin(i * 1.5) * 30);
                        const ry = topY + (Math.cos(i * 1.5) * 20);
                        ctx.fillStyle = '#3D2514';
                        ctx.beginPath();
                        ctx.arc(rx, ry, 4, 0, Math.PI * 2);
                        ctx.fill();
                    }
                } else if (toppingKey === 'moonchips') {
                    const coords = [[-18, 0], [12, -10], [-5, 18]];
                    coords.forEach(([dx, dy]) => {
                        ctx.font = '20px sans-serif';
                        ctx.fillText('🌙', centerX + dx - 10, topY + dy);
                    });
                } else if (toppingKey === 'mystery_red_sauce') {
                    ctx.strokeStyle = '#DC2626';
                    ctx.lineWidth = 5;
                    ctx.beginPath();
                    ctx.moveTo(centerX - 30, topY - 10);
                    ctx.quadraticCurveTo(centerX, topY + 20, centerX + 30, topY - 10);
                    ctx.stroke();
                }
            });

            ctx.restore();
        }

        /* SERVE & EVALUATION SYSTEM (40-Point Scale) */
        function serveOrder() {
            if (!playerCup.selectedCup) {
                alert("Please build an order first!");
                return;
            }

            const levelData = GAME_LEVELS[currentLevelIndex];
            const targetOrder = levelData.customers[currentCustomerIndex].order;

            // 1. Accuracy Score (Max 20 pts)
            let accuracy = 20;
            // Cup size match
            if (playerCup.selectedCup !== targetOrder.cup) {
                accuracy -= 7;
            }
            // Flavor match
            if (playerCup.flavor !== targetOrder.flavor) {
                accuracy -= 7;
            }
            // Toppings match
            const requiredToppings = targetOrder.toppings || [];
            const playerToppings = playerCup.toppings || [];
            
            let toppingDiff = 0;
            requiredToppings.forEach(t => {
                if (!playerToppings.includes(t)) toppingDiff++;
            });
            playerToppings.forEach(t => {
                if (!requiredToppings.includes(t)) toppingDiff++;
            });

            accuracy -= (toppingDiff * 3);
            if (accuracy < 0) accuracy = 0;

            // 2. Speed Score (Max 10 pts - cozy, no harsh penalty)
            const elapsedTimeSec = (Date.now() - customerStartTime) / 1000;
            let speed = 10;
            if (elapsedTimeSec > 35) speed = 7;

            // 3. Precision Score (Max 10 pts)
            let precision = 10;
            if (playerCup.flavorAmount < 50 || playerCup.flavorAmount > 95) {
                precision = 6;
            }

            const totalScore = accuracy + speed + precision; // Max 40
            customerScores.push({ accuracy, speed, precision, total: totalScore });

            // Display Rating Modal
            showRatingModal(totalScore, accuracy, speed, precision);
        }

        function showRatingModal(total, accuracy, speed, precision) {
            const customer = GAME_LEVELS[currentLevelIndex].customers[currentCustomerIndex];
            
            document.getElementById('score-accuracy').innerText = `${accuracy} / 20`;
            document.getElementById('score-speed').innerText = `${speed} / 10`;
            document.getElementById('score-precision').innerText = `${precision} / 10`;
            document.getElementById('score-total').innerText = `${total} / 40 pts`;

            const percentage = (total / 40) * 100;
            const emojiElem = document.getElementById('rating-emoji');
            const feedbackElem = document.getElementById('rating-feedback');

            if (percentage >= 80) {
                playSound('win');
                emojiElem.innerText = "⭐⭐⭐";
                feedbackElem.innerText = `"${customer.feedbackGood}"`;
            } else {
                playSound('retry');
                emojiElem.innerText = "⭐⭐";
                feedbackElem.innerText = `"${customer.feedbackOkay}"`;
            }

            document.getElementById('view-rating').classList.remove('hidden');
        }

        function nextCustomer() {
            playSound('click');
            document.getElementById('view-rating').classList.add('hidden');

            const levelData = GAME_LEVELS[currentLevelIndex];
            if (currentCustomerIndex + 1 < levelData.customers.length) {
                loadCustomer(currentCustomerIndex + 1);
            } else {
                // End of Level Evaluation
                evaluateLevelEnd();
            }
        }

        function evaluateLevelEnd() {
            const levelData = GAME_LEVELS[currentLevelIndex];
            const maxTotalPossible = levelData.customers.length * 40;
            const earnedTotal = customerScores.reduce((sum, item) => sum + item.total, 0);
            const overallRatio = earnedTotal / maxTotalPossible;

            const summaryModal = document.getElementById('view-summary');
            const winScreen = document.getElementById('summary-win');
            const retryScreen = document.getElementById('summary-retry');

            summaryModal.classList.remove('hidden');

            if (overallRatio >= levelData.passThreshold) {
                // PASSED LEVEL!
                playSound('win');
                winScreen.classList.remove('hidden');
                retryScreen.classList.add('hidden');

                document.getElementById('win-accuracy-percentage').innerText = `${Math.round(overallRatio * 100)}%`;
                document.getElementById('win-score-text').innerText = `You earned ${earnedTotal} out of ${maxTotalPossible} total points!`;

                // Unlock next level in persistence
                if (currentLevelIndex + 1 < GAME_LEVELS.length) {
                    unlockedLevels[currentLevelIndex + 1] = true;
                    saveProgress();
                    renderLevelSelectionBadges();
                }
            } else {
                // TRY AGAIN SCREEN (Shop Dog screen)
                playSound('retry');
                retryScreen.classList.remove('hidden');
                winScreen.classList.add('hidden');

                document.getElementById('retry-accuracy-percentage').innerText = `${Math.round(overallRatio * 100)}%`;
            }
        }

        /* Modal Helpers */
        function showLevelSelectModal() {
            playSound('click');
            document.getElementById('modal-level-select').classList.remove('hidden');
        }
        function hideLevelSelectModal() {
            playSound('click');
            document.getElementById('modal-level-select').classList.add('hidden');
        }
        function showInstructions() {
            playSound('click');
            document.getElementById('modal-instructions').classList.remove('hidden');
        }
        function hideInstructions() {
            playSound('click');
            document.getElementById('modal-instructions').classList.add('hidden');
        }
    </script>
